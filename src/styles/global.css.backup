@font-face {
  font-family: "Roboto Mono";
  src: url("../assets/roboto-mono-regular.ttf") format("truetype");
  font-weight: 400;
}

@font-face {
  font-family: "Roboto Mono";
  src: url("../assets/roboto-mono-700.ttf") format("truetype");
  font-weight: 700;
}

:root {
  --background: #faf9f6;
  --text: #202124;
  --muted: #6b6b6b;
  --accent: #b4532a;
  --line: #dedbd5;
  --max-width: 1200px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: "Roboto Mono", monospace;
  font-size: 13px;
  line-height: 1.8;
}

a {
  color: inherit;
  text-decoration: none;
}

a:hover {
  color: var(--accent);
}

.container {
  width: min(var(--max-width), calc(100% - 40px));
  margin: 0 auto;
}

/* Header */

.header {
  border-bottom: 1px solid var(--line);
}

.nav-wrap {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.logo {
  font-weight: 700;
  font-size: 16px;
}

.logo span {
  color: var(--accent);
}

.nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  font-size: 11px;
}

.nav a {
  color: var(--muted);
}

.nav a:hover {
  color: var(--accent);
}

/* Main */

.main {
  padding: 35px 0 65px;
}

/* Home */

.home-intro {
  max-width: 760px;
  padding: 25px 0 40px;
}

.eyebrow {
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin: 0 0 18px;
}

h1 {
  font-size: clamp(34px, 5vw, 50px);
  line-height: 1.15;
  letter-spacing: -1.5px;
  margin: 0 0 25px;
}

.lead {
  color: var(--text);
  font-size: 15px;
  max-width: 720px;
}

.home-intro > p:not(.eyebrow) {
  max-width: 720px;
}

.text-link {
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
}

.simple-section {
  padding: 28px 0;
  border-top: 1px solid var(--line);
}

.simple-section h2 {
  font-size: 18px;
  margin: 0 0 25px;
  letter-spacing: -0.5px;
}

.simple-section ul {
  margin: 0;
  padding-left: 20px;
  max-width: 780px;
}

.simple-section li {
  margin-bottom: 9px;
  color: var(--muted);
}

.simple-row {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.simple-row:first-of-type {
  padding-top: 0;
}

.row-main {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.row-main span,
.row-date {
  color: var(--muted);
  font-size: 11px;
}

.row-date {
  white-space: nowrap;
}

.publication-feature {
  max-width: 780px;
}

.publication-feature strong {
  display: block;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 8px;
}

.publication-feature p {
  color: var(--muted);
  font-size: 11px;
  margin: 0 0 12px;
}

.contact {
  display: flex;
  align-items: baseline;
  gap: 25px;
  flex-wrap: wrap;
}

.contact h2 {
  margin-right: 15px;
}

.contact span {
  color: var(--muted);
  font-size: 11px;
}

/* Generic pages */

.page-intro {
  max-width: 760px;
  padding: 25px 0 35px;
}

.page-intro h1 {
  margin-bottom: 22px;
}

.page-intro p {
  color: var(--muted);
  max-width: 720px;
}

.section {
  margin-top: 35px;
  padding-top: 35px;
  border-top: 1px solid var(--line);
}

.section > h2 {
  font-size: 18px;
  margin: 0 0 25px;
}

.item {
  padding: 22px 0;
  border-bottom: 1px solid var(--line);
}

.item:last-child {
  border-bottom: 0;
}

.item h3 {
  font-size: 14px;
  line-height: 1.6;
  margin: 0 0 8px;
}

.item p {
  color: var(--muted);
  font-size: 11px;
}

.meta {
  color: var(--muted);
  font-size: 10px;
}

.item ul {
  padding-left: 20px;
}

.item li {
  color: var(--muted);
  font-size: 11px;
  margin-bottom: 6px;
}

/* Footer */

.footer {
  border-top: 1px solid var(--line);
}

.footer-inner {
  min-height: 100px;
  padding: 25px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.footer strong {
  font-size: 11px;
}

.footer p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 9px;
}

.footer-links {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 10px;
}

/* Mobile */

@media (max-width: 700px) {
  .container {
    width: calc(100% - 30px);
  }

  .nav-wrap {
    padding: 18px 0;
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .nav {
    gap: 10px 15px;
  }

  .main {
    padding-top: 35px;
  }

  .home-intro,
  .page-intro {
    padding-top: 25px;
  }

  h1 {
    font-size: 40px;
  }

  .simple-row {
    flex-direction: column;
    gap: 4px;
  }

  .row-date {
    order: -1;
  }

  .contact {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .footer-inner {
    align-items: flex-start;
    flex-direction: column;
  }
}


/* Compact inner pages */
.page-intro {
  padding: 10px 0 25px;
}

.page-intro h1 {
  margin-bottom: 12px;
}

.page-intro p {
  margin-bottom: 10px;
}

.section {
  margin-top: 25px;
  padding-top: 20px;
}

.section > h2 {
  margin-bottom: 15px;
}

.item {
  padding: 13px 0;
}

.item h3 {
  margin-bottom: 5px;
}

.item p {
  margin: 5px 0;
}

.item ul {
  margin-top: 6px;
}

.item li {
  margin-bottom: 4px;
}

.logo {
  display: flex;
  flex-direction: column;
  gap: 2px;
  line-height: 1.3;
}

.logo strong {
  font-size: 17px;
  letter-spacing: -0.5px;
}

.logo span {
  color: var(--muted);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0;
}

.nav-contact {
  color: var(--accent) !important;
  font-weight: 700;
}

.contact-page {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 80px;
  padding-top: 10px;
}

.contact-info h2 {
  font-size: 18px;
  margin: 0 0 20px;
}

.contact-info a {
  display: flex;
  flex-direction: column;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
  font-size: 12px;
}

.contact-info a span {
  color: var(--muted);
  font-size: 10px;
  margin-bottom: 3px;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 11px;
  font-weight: 700;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: transparent;
  padding: 12px;
  font-family: inherit;
  font-size: 12px;
  color: var(--text);
  outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: var(--accent);
}

.contact-form textarea {
  resize: vertical;
}

.contact-form button {
  width: fit-content;
  border: 0;
  background: var(--accent);
  color: white;
  padding: 12px 18px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

@media (max-width: 700px) {
  .contact-page {
    grid-template-columns: 1fr;
    gap: 45px;
  }
}

.contact-social-icons,
.footer-social-icons {
  display: flex;
  align-items: center;
  gap: 18px;
}

.contact-social-icons {
  margin-top: 22px;
}

.contact-social-icons a,
.footer-social-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  transition: opacity 0.2s ease;
}

.contact-social-icons a:hover,
.footer-social-icons a:hover {
  opacity: 0.55;
}

.contact-social-icons svg,
.footer-social-icons svg {
  width: 21px;
  height: 21px;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16px;
}

.footer-social-icons {
  gap: 16px;
}

@media (max-width: 700px) {
  .footer-right {
    align-items: flex-start;
  }
}

/* Footer navigation and social links */

.footer-inner {
  align-items: center;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 18px;
  color: var(--muted);
  font-size: 10px;
}

.footer-social-icons {
  display: flex;
  align-items: center;
  gap: 18px;
}

.footer-social-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
}

.footer-social-icons svg {
  width: 20px;
  height: 20px;
}

.footer-social-icons a:hover {
  color: var(--accent);
}

.contact-social-icons {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 20px;
}

.contact-social-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
}

.contact-social-icons svg {
  width: 21px;
  height: 21px;
}

@media (max-width: 700px) {
  .footer-right {
    align-items: flex-start;
  }

  .footer-links {
    justify-content: flex-start;
  }
}

/* Final footer layout */

.footer {
  border-top: 1px solid var(--line);
  margin-top: 20px;
}

.footer-main {
  min-height: 105px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 30px;
}

.footer-left {
  justify-self: start;
}

.footer-left strong {
  font-size: 13px;
}

.footer-left p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.footer-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  font-size: 10px;
  color: var(--muted);
  white-space: nowrap;
}

.footer-nav a:hover {
  color: var(--accent);
}

.footer-social-icons {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 18px;
}

.footer-social-icons a {
  display: inline-flex;
  color: var(--text);
}

.footer-social-icons a:hover {
  color: var(--accent);
}

.footer-social-icons svg {
  width: 20px;
  height: 20px;
}

.footer-bottom {
  border-top: 1px solid var(--line);
  padding: 12px 0 18px;
  text-align: center;
  color: var(--muted);
  font-size: 9px;
}

@media (max-width: 900px) {
  .footer-main {
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 18px;
    padding: 25px 0;
  }

  .footer-left,
  .footer-social-icons {
    justify-self: center;
  }

  .footer-nav {
    flex-wrap: wrap;
    white-space: normal;
  }
}

/* Background images */

body {
  position: relative;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  background-size: cover;
  background-position: center;
  opacity: 0.055;
  pointer-events: none;
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background: var(--background);
  opacity: 0.88;
  pointer-events: none;
}

/* Home: one stable image */

.home-page::before {
  background-image: url("/images/work-1.jpg");
}

/* Other pages: automatic image rotation */

.inner-page::before {
  background-image: url("/images/work-1.jpg");
  animation: workBackground 25s infinite;
}

@keyframes workBackground {
  0%, 18% {
    background-image: url("/images/work-1.jpg");
  }

  20%, 38% {
    background-image: url("/images/work-2.jpg");
  }

  40%, 58% {
    background-image: url("/images/work-3.jpg");
  }

  60%, 78% {
    background-image: url("/images/work-4.jpg");
  }

  80%, 100% {
    background-image: url("/images/work-5.jpg");
  }
}

/* About profile */

.about-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 70px;
  align-items: start;
}

.about-content {
  min-width: 0;
}

.profile-photo-wrap {
  display: flex;
  justify-content: flex-end;
  padding-top: 15px;
}

.profile-photo {
  width: 240px;
  height: 280px;
  object-fit: cover;
  border-radius: 4px;
  border: 1px solid var(--line);
}

@media (max-width: 700px) {
  .about-layout {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .profile-photo-wrap {
    justify-content: flex-start;
    order: -1;
  }

  .profile-photo {
    width: 180px;
    height: 220px;
  }
}

/* Home profile hero */
.home-hero {
  min-height: 540px;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 35px;
}

.home-profile {
  height: 540px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.home-profile img {
  width: 100%;
  max-width: 430px;
  height: 100%;
  object-fit: contain;
  object-position: bottom center;
}

@media (max-width: 700px) {
  .home-hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .home-profile {
    height: 400px;
    order: -1;
  }

  .home-profile img {
    max-width: 320px;
  }
}

.home-profile {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 420px;
  height: 520px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 2;
}

.home-profile img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: bottom center;
  display: block;
}

.home-intro {
  position: relative;
  min-height: 520px;
  padding-right: 420px;
}

@media (max-width: 700px) {
  .home-intro {
    padding-right: 0;
  }

  .home-profile {
    position: relative;
    right: auto;
    bottom: auto;
    width: 100%;
    height: 380px;
    margin-top: 30px;
  }
}

/* FINAL HOME HERO FIX */
.home-hero {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
}

.home-intro {
  width: 58%;
  max-width: 700px;
  min-height: auto;
  padding: 55px 0 65px;
  position: relative;
  z-index: 3;
}

.home-profile {
  position: absolute;
  right: 20px;
  bottom: 0;
  width: 43%;
  height: 560px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
  z-index: 2;
  padding: 0;
}

.home-profile img {
  display: block;
  width: 100%;
  max-width: 460px;
  height: 100%;
  object-fit: contain;
  object-position: bottom center;
}

.home-intro h1 {
  max-width: 650px;
}

.home-intro .lead,
.home-intro > p:not(.eyebrow) {
  max-width: 700px;
}

@media (max-width: 900px) {
  .home-intro {
    width: 58%;
  }

  .home-profile {
    width: 45%;
    right: 0;
  }
}

@media (max-width: 700px) {
  .home-hero {
    display: flex;
    flex-direction: column;
    min-height: auto;
  }

  .home-intro {
    width: 100%;
    padding: 35px 0 20px;
  }

  .home-profile {
    position: relative;
    right: auto;
    bottom: auto;
    width: 100%;
    height: 400px;
    margin-top: 10px;
  }

  .home-profile img {
    max-width: 330px;
  }
}


/* FINAL: PROFILE ON RIGHT SIDE */
.home-hero {
  position: relative !important;
  display: block !important;
  min-height: 560px !important;
  width: 100% !important;
  overflow: hidden !important;
}

.home-intro {
  position: relative !important;
  z-index: 5 !important;
  width: 60% !important;
  max-width: 700px !important;
  padding: 55px 0 65px !important;
}

.home-profile {
  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: auto !important;
  width: 38% !important;
  height: 560px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex !important;
  align-items: flex-end !important;
  justify-content: center !important;
  z-index: 2 !important;
  overflow: hidden !important;
}

.home-profile img {
  display: block !important;
  width: 100% !important;
  max-width: 460px !important;
  height: 100% !important;
  object-fit: contain !important;
  object-position: center bottom !important;
  margin: 0 !important;
}

@media (max-width: 700px) {
  .home-hero {
    display: flex !important;
    flex-direction: column !important;
    min-height: auto !important;
  }

  .home-intro {
    width: 100% !important;
    padding: 35px 0 20px !important;
  }

  .home-profile {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    height: 380px !important;
    margin-top: 20px !important;
  }

  .home-profile img {
    max-width: 330px !important;
  }
}


/* ===== HOME HERO - FINAL LAYOUT ===== */

.home-hero {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  min-height: 560px !important;
  overflow: hidden !important;
  border-bottom: 1px solid var(--line);
}

.home-intro {
  position: relative !important;
  z-index: 3 !important;
  width: 62% !important;
  max-width: 760px !important;
  padding: 65px 0 70px !important;
}

.home-profile {
  position: absolute !important;
  z-index: 2 !important;

  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: auto !important;

  width: 42% !important;
  height: 560px !important;

  margin: 0 !important;
  padding: 0 !important;

  display: flex !important;
  align-items: flex-end !important;
  justify-content: flex-end !important;

  overflow: hidden !important;
}

.home-profile img {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;

  object-fit: contain !important;
  object-position: right bottom !important;

  margin: 0 !important;
  padding: 0 !important;
}

/* Keep text completely away from profile */
.home-intro h1,
.home-intro .lead,
.home-intro > p,
.home-intro .text-link {
  max-width: 760px;
}

/* Larger desktop screens */
@media (min-width: 1100px) {
  .home-intro {
    width: 60% !important;
  }

  .home-profile {
    width: 45% !important;
  }

  .home-profile img {
    width: 100% !important;
  }
}

/* Mobile */
@media (max-width: 700px) {
  .home-hero {
    min-height: auto !important;
    display: flex !important;
    flex-direction: column !important;
  }

  .home-intro {
    width: 100% !important;
    padding: 40px 0 25px !important;
  }

  .home-profile {
    position: relative !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;

    width: 100% !important;
    height: 390px !important;

    justify-content: center !important;
  }

  .home-profile img {
    width: 100% !important;
    height: 100% !important;
    object-position: center bottom !important;
  }
}


/* FINAL HOME HERO */

.home-hero {
  position: relative;
  min-height: 540px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 430px;
  align-items: center;
  gap: 40px;
  padding: 70px 0 0;
  overflow: hidden;
}

.home-intro {
  position: relative;
  z-index: 2;
  max-width: 760px;
  padding: 0;
}

.home-intro h1 {
  margin-bottom: 25px;
}

.home-profile {
  position: relative;
  z-index: 1;
  height: 540px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}

.home-profile img {
  display: block;
  width: auto;
  height: 520px;
  max-width: 100%;
  object-fit: contain;
  object-position: bottom center;
}

@media (max-width: 900px) {
  .home-hero {
    grid-template-columns: 1fr 320px;
    gap: 20px;
  }

  .home-profile {
    height: 460px;
  }

  .home-profile img {
    height: 450px;
  }
}

@media (max-width: 700px) {
  .home-hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 35px;
  }

  .home-profile {
    height: 400px;
    order: 2;
    margin-top: 10px;
  }

  .home-profile img {
    height: 390px;
  }
}


