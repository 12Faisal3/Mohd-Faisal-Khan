---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta
    name="description"
    content="Mohd Faisal Khan — Researcher and Hardware Designer"
  />
  <title>{Astro.props.title || "Mohd Faisal Khan"}</title>
</head>

<body>

  <header class="header">
    <div class="container nav-wrap">

      <a href="/" class="logo">
        <strong>Mohd Faisal Khan</strong>
        <span>PhD Scholar · Researcher · Hardware Designer</span>
      </a>

      <nav class="nav">
        <a href="/" class:list={{ active: Astro.url.pathname === "/" }}>Home</a>
        <a href="/about" class:list={{ active: Astro.url.pathname.startsWith("/about") }}>About</a>
        <a href="/research" class:list={{ active: Astro.url.pathname.startsWith("/research") }}>Research</a>
        <a href="/projects" class:list={{ active: Astro.url.pathname.startsWith("/projects") }}>Projects</a>
        <a href="/publications" class:list={{ active: Astro.url.pathname.startsWith("/publications") }}>Publications</a>
        <a href="/experience" class:list={{ active: Astro.url.pathname.startsWith("/experience") }}>Experience</a>
        <a href="/contact" class:list={{ active: Astro.url.pathname.startsWith("/contact") }}>Get in touch</a>
      </nav>

    </div>
  </header>

  <main class="container main">
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-main">

      <div class="footer-left">
        <strong>Mohd Faisal Khan</strong>
        <p>Researcher · Hardware Designer</p>
      </div>

      <nav class="footer-nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/research">Research</a>
        <a href="/projects">Projects</a>
        <a href="/publications">Publications</a>
        <a href="/experience">Experience</a>
      </nav>

      <div class="footer-social-icons">

        <a href="mailto:phd2401102011@iiti.ac.in" aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="m4 6 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </a>

        <a
          href="https://scholar.google.com/citations?hl=en&user=0SEFVhoAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Scholar"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 2 9l10 6 10-6-10-6Z" fill="currentColor"/>
            <path d="M6 12v4c0 2 2.7 3.5 6 3.5s6-1.5 6-3.5v-4l-6 3.5L6 12Z" fill="currentColor"/>
          </svg>
        </a>

        <a
          href="https://www.linkedin.com/in/faisal0011/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3.5A2.5 2.5 0 1 1 5 8a2.5 2.5 0 0 1 0-4.5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.6 4.8 6v6.4h-4v-5.7c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9V9Z" fill="currentColor"/>
          </svg>
        </a>

      </div>
    </div>

    <div class="container footer-bottom">
      © 2026 Mohd Faisal Khan. All rights reserved.
    </div>
  </footer>

</body>
</html>
