---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
import { research } from "../data/research";
import { education } from "../data/education";
---

<Base title={profile.name}>
  <section class="home-hero">
    <div class="home-intro">
      <p class="eyebrow">{profile.title}</p>

      <h1>{profile.name}</h1>

      <p class="lead">{profile.intro}</p>

      <p>{profile.description}</p>

      <a class="text-link" href="/research">
        Explore my research and achievements →
      </a>
    </div>

    <div class="home-profile">
      <img src="/images/profile.png" alt={profile.name} />
    </div>
  </section>

  <section class="simple-section">
    <h2>Research interests</h2>
    <ul>
      {research.focus.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="simple-section">
    <h2>Education</h2>

    {education.map((item) => (
      <div class="simple-row">
        <div class="row-main">
          <strong>{item.degree} — {item.field}</strong>
          <span>{item.institution}</span>
        </div>
        <span class="row-date">{item.period}</span>
      </div>
    ))}
  </section>

  <section class="simple-section">
    <h2>Featured publication</h2>

    <div class="publication-feature">
      <strong>{profile.featuredPublication.title}</strong>
      <p>{profile.featuredPublication.venue}</p>

      <a
        class="text-link"
        href={profile.featuredPublication.link}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read the paper →
      </a>
    </div>
  </section>
</Base>
