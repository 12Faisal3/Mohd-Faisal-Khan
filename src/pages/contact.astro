---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title={`Contact — ${profile.name}`}>
  <div class="page-intro">
    <h1>Get in touch</h1>
    <p>
      Interested in research, collaboration, publications, or academic work?
      Feel free to reach out.
    </p>
  </div>

  <section class="contact-page">
    <div class="contact-info">
      <h2>Contact</h2>

      <a href={`mailto:${profile.email}`}>
        <span>Email</span>
        {profile.email}
      </a>

      <a href={`tel:${profile.phone.replace(/\D/g, "")}`}>
        <span>Phone</span>
        {profile.phone}
      </a>

      <div class="contact-social-icons">

        <a href={`mailto:${profile.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="m4 6 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </a>

        <a
          href="https://scholar.google.com/citations?hl=en&user=0SEFVhoAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Scholar"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 2 9l10 6 10-6-10-6Z" fill="currentColor"/>
            <path d="M6 12v4c0 2 2.7 3.5 6 3.5s6-1.5 6-3.5v-4l-6 3.5L6 12Z" fill="currentColor"/>
          </svg>
        </a>

        <a
          href="https://www.linkedin.com/in/faisal0011/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3.5A2.5 2.5 0 1 1 5 8a2.5 2.5 0 0 1 0-4.5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.6 4.8 6v6.4h-4v-5.7c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9V9Z" fill="currentColor"/>
          </svg>
        </a>

      </div>
    </div>

    <form
      class="contact-form"
      action={`mailto:${profile.email}`}
      method="post"
      enctype="text/plain"
    >
      <label>
        Name
        <input type="text" name="name" required />
      </label>

      <label>
        Email
        <input type="email" name="email" required />
      </label>

      <label>
        Message
        <textarea name="message" rows="6" required></textarea>
      </label>

      <button type="submit">Send message →</button>
    </form>
  </section>
</Base>
